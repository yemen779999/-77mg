rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Match any document in the 'users' collection
    match /users/{userId} {
      // Allow read/write access only if the authenticated user's ID matches the document's userId
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Match all subcollections and documents under the specific user's document
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
